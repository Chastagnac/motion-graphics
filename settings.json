{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(*)",
      "Bash(npm run lint *)",
      "Bash(git diff *)",
      "Read(~/.zshrc)"
    ],
    "deny": [
      "Bash(rm -rf *)",
      "Read(./.env)",
      "Read(./secrets/**)"
    ],
    "ask": [
      "Bash(git push *)"
    ],
    "defaultMode": "default",
    "additionalDirectories": []
  },
  "env": {},
  "model": "claude-sonnet-5",
  "includeCoAuthoredBy": false,
  "cleanupPeriodDays": 30
}   